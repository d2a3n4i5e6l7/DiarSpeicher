<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.8.2" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Dapper.AOT" Version="1.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Authorization" Version="$(BundledNETCoreAppPackageVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(BundledNETCoreAppPackageVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Gateway" Version="$(BundledNETCoreAppPackageVersion)" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="$(BundledNETCoreAppPackageVersion)" />
    <PackageVersion Include="MudBlazor" Version="9.11.0" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="PDFtoImage" Version="5.4.0" />
    <PackageVersion Include="SharpCompress" Version="0.50.4" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.34.0.3385" />
    <PackageVersion Include="SkiaSharp" Version="4.152.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.152.1" />
    <PackageVersion Include="Ulid" Version="1.4.1" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
