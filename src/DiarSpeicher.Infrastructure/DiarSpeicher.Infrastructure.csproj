<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DiarSpeicher.Core\DiarSpeicher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <!-- Sin "runtime": Design y Tools solo hacen falta para "dotnet ef migrations add".
           Incluyendolo se copian sus ensamblados al publish y arrastran Roslyn entero,
           22 MB de compilador de C# que en produccion no ejecuta nada. Aplicar las
           migraciones al arrancar lo hace EntityFrameworkCore.Relational, que se queda. -->
      <IncludeAssets>build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
      <!-- Sin "runtime": Design y Tools solo hacen falta para "dotnet ef migrations add".
           Incluyendolo se copian sus ensamblados al publish y arrastran Roslyn entero,
           22 MB de compilador de C# que en produccion no ejecuta nada. Aplicar las
           migraciones al arrancar lo hace EntityFrameworkCore.Relational, que se queda. -->
      <IncludeAssets>build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="SkiaSharp" Version="4.151.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
