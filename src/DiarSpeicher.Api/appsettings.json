{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=diarspeicher.db;Cache=Shared;Mode=ReadWriteCreate;"
  },
  "AllowedHosts": "*",
  "Gateway": {
    "PathBase": "",
    "PublicPaths": []
  },
  "Storage": {
    "RootPath": "storage",
    "Backup": {
      "Enabled": true,
      "IntervalHours": 12
    },
    "Upload": {
      "MaxRequestBytes": 10737418240,
      "EnableUpload": true,
      "MaxFileUploadSize": 5368709120
    }
  }
}
