{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=diarspeicher.db;Cache=Shared;Mode=ReadWriteCreate;"
  },
  "AllowedHosts": "*",
  "Gateway": {
    "PathBase": "",
    "PublicPaths": []
  },
  "Storage": {
    "RootPath": "storage",
    "PageCache": {
      "Enabled": true,
      "MaxBytes": 2147483648,
      "MaxEntryBytes": 33554432,
      "EvictionTargetRatio": 0.9
    },
    "Backup": {
      "Enabled": true,
      "IntervalHours": 12
    },
    "Upload": {
      "MaxRequestBytes": 1073741824,
      "EnableUpload": true,
      "MaxFileUploadSize": 524288000
    }
  }
}
