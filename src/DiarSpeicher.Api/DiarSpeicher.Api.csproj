<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\DiarSpeicher.Infrastructure\DiarSpeicher.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.6.4" />
    <PackageReference Include="HotChocolate.Data.EntityFramework" Version="16.6.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <!-- Sin "runtime": Design y Tools solo hacen falta para "dotnet ef migrations add".
           Incluyendolo se copian sus ensamblados al publish y arrastran Roslyn entero,
           22 MB de compilador de C# que en produccion no ejecuta nada. Aplicar las
           migraciones al arrancar lo hace EntityFrameworkCore.Relational, que se queda. -->
      <IncludeAssets>build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
