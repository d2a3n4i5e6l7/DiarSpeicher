# Prefijo publico del plugin en el Gateway. El nombre es arbitrario: lo que se
# ponga aqui debe coincidir con el "Prefijo Publico" del montaje en el Gateway
VITE_URL_ACCESS=/diarspeicher

# URL del Gateway. Admite varios candidatos separados por coma: en dev se prueba
# cual responde; en el navegador se sobrescribe a vacio para usar el mismo origen
VITE_GATEWAY_URL=https://127.0.0.1:5050,https://localhost:5050
