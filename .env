# Prefijo publico bajo el que el Gateway monta este servicio, sin barras.
# Vacio = servido desde la raiz.
PATH_BASE=diarspeicher
# Red Docker externa compartida con el Gateway.
NETWORK_NAME=diarmund_gateway

# Usuario del host que posee STORAGE_PATH. El contenedor escribe con este uid/gid.
PUID=1000
PGID=1000

# Ruta del host para la base de datos, miniaturas y cache de paginas.
STORAGE_PATH=./storage

# Ruta del host con las bibliotecas de comics. Se monta en lectura y escritura:
# con ENABLE_UPLOAD=true el destino final de las subidas es esta misma ruta.
LIBRARIES_PATH=./libraries

# Techo de la cache de paginas en disco, en bytes.
PAGE_CACHE_BYTES=2147483648

# Copia de la base de datos cada N horas. Se guardan solo dos, back1.db y back2.db,
# en <STORAGE_PATH>/backups y rotando siempre sobre la mas antigua.
ENABLE_BACKUP=true
BACKUP_INTERVAL_HOURS=12

# Subida de ficheros desde la API.
ENABLE_UPLOAD=true
# Opciones de arquitectura disponibles: linux/arm64 (TV Box / CoreELEC), linux/amd64 (PC / Servidor x86_64)
ARCHITECTURE=linux/arm64
