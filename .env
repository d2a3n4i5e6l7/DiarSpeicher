# Prefijo publico bajo el que el Gateway monta este servicio, sin barras.
# Vacio = servido desde la raiz.
PATH_BASE=diarspeicher
# Red Docker externa compartida con el Gateway.
NETWORK_NAME=r4m

# Ruta del host para la base de datos, miniaturas y cache de paginas.
STORAGE_PATH=./storage

# Ruta del host con las bibliotecas de comics. Se monta en solo lectura.
LIBRARIES_PATH=./libraries

# Techo de la cache de paginas en disco, en bytes.
PAGE_CACHE_BYTES=2147483648

# Subida de ficheros desde la API.
ENABLE_UPLOAD=true
